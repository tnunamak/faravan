[Unit]
Description=Faravan local app (v1: lending, jobs and the web app on 127.0.0.1)
Documentation=https://github.com/tnunamak/faravan
After=network-online.target

[Service]
Type=simple
Environment=PATH=/usr/lib/faravan/bin:/usr/lib/faravan/runtime/bin:/usr/local/bin:/usr/bin:/bin
UnsetEnvironment=DBUS_SESSION_BUS_ADDRESS
Environment=FARAVAN_NO_BROWSER=1
Environment=FARAVAN_RESIDENT_AUTOSTART=1
ExecStart=/usr/bin/faravan app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
