[Unit]
Description=Faravan resident app and tray recovery
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=PATH=/usr/lib/faravan/bin:/usr/lib/faravan/runtime/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/lib/faravan/runtime/bin/node /usr/lib/faravan/lib/v1/resident.mjs --background --tray /usr/lib/faravan/faravan-tray
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
