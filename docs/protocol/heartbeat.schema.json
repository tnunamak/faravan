{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://faravan.dev/protocol/v1/heartbeat.schema.json",
  "title": "Faravan v1 heartbeat (optional presence channel)",
  "description": "A member may send only capabilities when the host advertises member_capabilities_v1. This signed declaration records protocol support without changing lending presence or online status. The last declaration remains in member_capabilities in presence, and a later full heartbeat replaces it. Full heartbeats are sent by a lending device every 30 s, whether or not it is claiming work. The coordinator takes the device from the signed request proof and the time from its own clock; it never trusts a claimed person. A device is online when its last heartbeat is under 90 s old. The body never carries a job, a person's name, a path or a prompt. An older lender sends none; the coordinator then falls back to the time of its last claim-next poll and assumes it has no new capabilities.",
  "type": "object",
  "additionalProperties": false,
  "oneOf": [{"required": ["seq", "intent", "execution", "blockers", "agents", "capabilities"]}, {"required": ["capabilities"], "maxProperties": 1}],
  "properties": {
    "boot": { "description": "Optional. One id per lender process. seq restarts at 0 with each process, so the coordinator compares seq only between heartbeats with the same boot; a heartbeat with a different boot (or none) replaces the stored one. Older lenders send none.", "type": "string", "pattern": "^[A-Za-z0-9_-]{8,40}$" },
    "seq": { "description": "Increases with each heartbeat of one boot; an older one of the same boot never replaces a newer one.", "type": "integer", "minimum": 0 },
    "intent": {
      "type": "object", "additionalProperties": false, "required": ["state"],
      "properties": {
        "state": { "enum": ["off", "paused", "outside", "resting", "ready", "starting", "blocked", "update"] },
        "reason": { "type": ["string", "null"], "maxLength": 60 },
        "until": { "type": ["integer", "null"], "minimum": 0, "description": "Epoch milliseconds." }
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false, "required": ["state"],
      "properties": {
        "state": { "enum": ["idle", "running", "finishing", "stopping"] },
        "stops_by": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "blockers": {
      "type": "array", "maxItems": 16,
      "items": { "type": "object", "additionalProperties": false, "required": ["kind"],
        "properties": { "kind": { "type": "string", "maxLength": 60 }, "agent": { "type": "string", "maxLength": 60 } } }
    },
    "agents": {
      "type": "array", "maxItems": 8,
      "items": { "type": "object", "additionalProperties": false, "required": ["adapter", "readiness"],
        "properties": {
          "adapter": { "type": "string", "maxLength": 60 },
          "readiness": { "enum": ["ready", "checking", "unknown", "signed_out", "not_installed"] },
          "models": { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 80 } },
          "per_job_max_minutes": { "type": ["integer", "null"], "minimum": 0 }
        } }
    },
    "budget": {
      "type": ["object", "null"], "additionalProperties": false,
      "properties": {
        "jobs_left_today": { "type": ["integer", "null"], "minimum": 0 },
        "minutes_left_today": { "type": ["integer", "null"], "minimum": 0 },
        "resets_at": { "type": ["integer", "null"], "minimum": 0 },
        "time_zone": { "type": ["string", "null"], "maxLength": 60 }
      }
    },
    "schedule": {
      "type": ["object", "null"], "additionalProperties": false,
      "properties": {
        "in_window": { "type": ["boolean", "null"] },
        "next_start": { "type": ["integer", "null"], "minimum": 0 },
        "next_end": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "capabilities": {
      "description": "What this lender can do beyond the base protocol, for example progress_v1.",
      "type": "array", "maxItems": 32, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9_]{1,40}$" }
    },
    "versions": {
      "type": ["object", "null"], "additionalProperties": false,
      "properties": { "faravan": { "type": ["string", "null"], "maxLength": 40 }, "protocol": { "type": ["string", "null"], "maxLength": 40 }, "sbx": { "type": ["string", "null"], "maxLength": 40 } }
    }
  }
}
